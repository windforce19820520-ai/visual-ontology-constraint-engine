{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voce.bundle-manifest/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "case", "pins", "files", "semanticHash", "createdBy"],
  "properties": {
    "schemaVersion": { "const": "voce.bundle-manifest/v1alpha1" },
    "kind": { "enum": ["compiled", "run", "evaluation", "trace", "release-candidate"] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 0 } }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "core", "contracts", "scenario"],
      "properties": {
        "tool": { "$ref": "#/$defs/versionPin" },
        "core": { "$ref": "#/$defs/versionPin" },
        "contracts": { "$ref": "#/$defs/versionPin" },
        "scenario": { "$ref": "#/$defs/versionPin" },
        "profile": { "$ref": "#/$defs/versionPin" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byteLength"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "byteLength": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "semanticHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "createdBy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "versionPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
