          },
          {
            "path": "camera.composition.framingDevices.frameWithinFrame",
            "valueKind": "boolean",
            "cardinality": "one",
            "defaultImportance": "preferred"
          },
          {
            "path": "camera.composition.framingDevices.environmentalPortrait",
            "valueKind": "boolean",
            "cardinality": "one",
            "defaultImportance": "preferred"
          },
