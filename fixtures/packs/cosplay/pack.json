    ],
    "rulePacks": [
      {
        "id": "cosplay.rules",
        "namespace": "voce.fixture.cosplay",
        "rules": [
          {
            "id": "visual-composition-leading-room-direction",
            "kind": "dependency",
            "operands": [
              {
                "id": "leading-room",
                "conditions": [
                  {
                    "path": "camera.composition.leadingRoom.enabled",
                    "operator": "equals",
                    "value": true
                  }
                ]
              },
              {
                "id": "direction",
                "conditions": [
                  {
                    "path": "camera.composition.leadingRoom.direction",
                    "operator": "present"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "degrade_operand",
              "operandId": "leading-room",
              "reasonCode": "LEADING_ROOM_DIRECTION_REQUIRED"
            },
            "importance": "preferred",
            "dependencyKind": "requires",
            "explanation": "Leading room requires an explicit direction."
          },
          {
            "id": "cosplay-hard-identity",
            "kind": "incompatibility",
            "operands": [
              {
                "id": "identity",
                "conditions": [
                  {
                    "path": "person.identity",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "face",
                "conditions": [
                  {
                    "path": "face.coverage",
                    "operator": "contains",
                    "value": "full_face"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "block",
              "reasonCode": "COSPLAY_HARD_IDENTITY"
            },
            "importance": "hard",
            "code": "COSPLAY_HARD_IDENTITY",
            "explanation": "Identity preservation and full-face coverage require an explicit hard block."
          },
          {
            "id": "cosplay-required-costume-character",
            "kind": "incompatibility",
            "operands": [
              {
                "id": "identity",
                "conditions": [
                  {
                    "path": "person.identity",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "costume",
                "conditions": [
                  {
                    "path": "character.costume",
                    "operator": "contains",
                    "value": "costume"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "block",
              "reasonCode": "COSPLAY_REQUIRED_COSTUME"
            },
            "importance": "required",
            "code": "COSPLAY_REQUIRED_COSTUME",
            "explanation": "Identity preservation and the costume requirement need an explicit waiver or block."
          },
          {
            "id": "cosplay-required-costume-wardrobe",
            "kind": "incompatibility",
            "operands": [
              {
                "id": "identity",
                "conditions": [
                  {
                    "path": "person.identity",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "costume",
                "conditions": [
                  {
                    "path": "wardrobe.costume",
                    "operator": "contains",
                    "value": "costume"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "block",
              "reasonCode": "COSPLAY_REQUIRED_COSTUME"
            },
            "importance": "required",
            "code": "COSPLAY_REQUIRED_COSTUME",
            "explanation": "Identity preservation and the costume requirement need an explicit waiver or block."
          },
          {
            "id": "cosplay-preferred-wig",
            "kind": "incompatibility",
            "operands": [
              {
                "id": "identity",
                "conditions": [
                  {
                    "path": "person.identity",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "wig",
                "conditions": [
                  {
                    "path": "hair.style",
                    "operator": "contains",
                    "value": "wig"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "degrade_operand",
              "operandId": "wig",
              "reasonCode": "COSPLAY_PREFERRED_WIG"
            },
            "importance": "preferred",
            "code": "COSPLAY_PREFERRED_WIG",
            "explanation": "A preferred wig request may be degraded deterministically when it conflicts with identity."
          },
          {
            "id": "cosplay-no-last-wins",
            "kind": "resource",
            "operands": [
              {
                "id": "hand-accessory",
                "conditions": [
                  {
                    "path": "accessories.hand",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "held-prop",
                "conditions": [
                  {
                    "path": "character.signatureProps.primary.handAssignment",
                    "operator": "contains",
                    "value": "held"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "block",
              "reasonCode": "COSPLAY_NO_LAST_WINS"
            },
            "importance": "required",
            "resourceId": "hand",
            "code": "COSPLAY_NO_LAST_WINS",
            "explanation": "Hand resource conflicts remain explicit; neither side silently wins."
          },
          {
            "id": "cosplay-prop-detail-requires-primary",
            "kind": "dependency",
            "operands": [
              {
                "id": "details",
                "conditions": [
                  {
                    "path": "character.signatureProps.primary.signatureDetails",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "type",
                "conditions": [
                  {
                    "path": "character.signatureProps.primary.type",
                    "operator": "present"
                  }
                ]
              },
              {
                "id": "silhouette",
                "conditions": [
                  {
                    "path": "character.signatureProps.primary.silhouette",
                    "operator": "present"
                  }
                ]
              }
            ],
            "resolution": {
              "strategy": "block",
              "reasonCode": "COSPLAY_PROP_DETAIL_REQUIRES_PRIMARY"
            },
            "importance": "required",
            "dependencyKind": "parent_detail",
            "code": "COSPLAY_PROP_DETAIL_REQUIRES_PRIMARY",
            "explanation": "Signature details depend on an identified prop type and primary silhouette."
          }
        ]
      }
    ],
    "interpretationScopes": [
      {
        "id": "cosplay.scope.person-identity",
        "assetRole": "person-identity",
        "bindings": [
          {
            "assetRole": "person-identity",
            "targetPath": "person.identity",
            "relation": "preserve",
            "priority": "hard"
          },
          {
            "assetRole": "person-identity",
            "targetPath": "style.rendering.medium",
            "relation": "preserve",
            "priority": "hard"
          },
          {
            "assetRole": "person-identity",
            "targetPath": "character.costume",
            "relation": "exclude",
            "priority": "hard"
          },
          {
            "assetRole": "person-identity",
            "targetPath": "character.signatureProps",
            "relation": "exclude",
            "priority": "hard"
          }
        ]
      },
      {
        "id": "cosplay.scope.character-design",
        "assetRole": "character-design",
        "bindings": [
          {
            "assetRole": "character-design",
            "targetPath": "person.identity",
            "relation": "exclude",
            "priority": "hard"
          },
          {
            "assetRole": "character-design",
            "targetPath": "character.hair",
            "relation": "reproduce",
            "priority": "required"
          },
          {
            "assetRole": "character-design",
            "targetPath": "character.costume",
            "relation": "reproduce",
            "priority": "required"
          },
          {
            "assetRole": "character-design",
            "targetPath": "character.accessories",
            "relation": "reproduce",
            "priority": "required"
          },
          {
            "assetRole": "character-design",
            "targetPath": "character.signatureProps.primary",
            "relation": "reproduce",
            "priority": "required"
          },
          {
            "assetRole": "character-design",
            "targetPath": "style",
            "relation": "exclude",
            "priority": "hard"
          }
        ]
      },
      {
        "id": "cosplay.scope.signature-prop-detail",
        "assetRole": "signature-prop-detail",
        "bindings": [
          {
            "assetRole": "signature-prop-detail",
            "targetPath": "person.identity",
            "relation": "exclude",
            "priority": "hard"
          },
          {
            "assetRole": "signature-prop-detail",
            "targetPath": "character.signatureProps.primary",
            "relation": "reproduce",
            "priority": "required"
          }
        ]
      },
      {
        "id": "cosplay.scope.pose",
        "assetRole": "pose",
        "bindings": [
          {
            "assetRole": "pose",
            "targetPath": "person.identity",
            "relation": "exclude",
            "priority": "hard"
          },
          {
            "assetRole": "pose",
            "targetPath": "pose",
            "relation": "reproduce",
            "priority": "preferred"
          }
        ]
      }
    ],
    "promptSections": [
      {
        "id": "cosplay.prompt.character-fidelity",
        "sections": [
          {
            "id": "subject-and-product-fidelity",
            "group": "subject-and-product-fidelity",
            "order": 1,
            "pathPrefixes": [
              "person",
              "character",
              "style"
            ],
            "requiredPaths": [
              "person.identity",
              "style.rendering.medium",
              "character.hair",
              "character.costume",
              "character.accessories",
              "character.signatureProps.primary.type",
              "character.signatureProps.primary.silhouette",
              "character.signatureProps.primary.proportion",
              "character.signatureProps.primary.colorScheme",
              "character.signatureProps.primary.signatureDetails",
              "character.signatureProps.primary.handAssignment",
              "character.signatureProps.primary.visibility"
            ],
            "templateKey": "composition.subject-and-product-fidelity"
          },
          {
            "id": "pose-and-object-relations",
            "group": "pose-and-object-relations",
            "order": 2,
            "pathPrefixes": [
              "pose",
              "prop",
              "object"
            ],
            "templateKey": "composition.pose-and-object-relations"
          },
          {
            "id": "composition-shot-and-crop",
            "group": "composition-shot-and-crop",
            "order": 3,
            "pathPrefixes": [
              "camera.framing"
            ],
            "templateKey": "composition.composition-shot-and-crop"
          },
          {
            "id": "composition-view-and-roll",
            "group": "composition-view-and-roll",
            "order": 4,
            "pathPrefixes": [
              "camera.view",
              "camera.roll"
            ],
            "templateKey": "composition.composition-view-and-roll"
          },
          {
            "id": "composition-layout-and-space",
            "group": "composition-layout-and-space",
            "order": 5,
            "pathPrefixes": [
              "camera.composition.patterns",
              "camera.composition.placement",
              "camera.composition.negativeSpace",
              "camera.composition.leadingRoom"
            ],
            "templateKey": "composition.composition-layout-and-space"
          },
          {
            "id": "composition-depth-framing-and-reflection",
            "group": "composition-depth-framing-and-reflection",
            "order": 6,
            "pathPrefixes": [
              "camera.composition.foregroundTreatment",
              "camera.composition.framingDevices",
              "camera.composition.reflection"
            ],
            "templateKey": "composition.composition-depth-framing-and-reflection"
          },
          {
            "id": "composition-lens-and-environment",
            "group": "composition-lens-and-environment",
            "order": 7,
            "pathPrefixes": [
              "camera.lens",
              "camera.composition.environmentRelationship",
              "camera.composition.subjectEnvironmentPlacement"
            ],
            "templateKey": "composition.composition-lens-and-environment"
          },
          {
            "id": "forbidden-and-output",
            "group": "forbidden-and-output",
            "order": 8,
            "pathPrefixes": [
              "output"
            ],
            "templateKey": "composition.forbidden-and-output"
          }
        ],
        "prohibitedInheritance": [
          "character-design:person.identity",
          "character-design:style",
          "person-identity:character.costume",
          "person-identity:character.signatureProps"
        ]
      }
    ],
    "reviewTemplates": [
      {
        "id": "cosplay.review.fidelity",
        "criteria": [
          {
            "id": "cosplay.identity-fidelity",
            "kind": "identity_fidelity",
            "targetPath": "person.identity",
            "importance": "hard",
            "prompt": "Check that the generated person preserves the approved real-person identity without inheriting the character reference face."
          },
          {
            "id": "cosplay.face-shape-fidelity",
            "kind": "identity_fidelity",
            "targetPath": "person.identity",
            "importance": "hard",
