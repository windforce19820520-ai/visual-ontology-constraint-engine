{
  "schemaVersion": "voce.scenario-pack-source/v1alpha1",
  "packId": "@voce-engine/scenario-product-shot",
  "version": "0.1.0",
  "kind": "root",
  "scenarioLabel": "product shot offline fixture",
  "declarations": { "mayHandlePersonImages": false, "rightsDisclosureRequired": false },
  "contributions": {
    "ontologyVocabulary": [{ "id": "visual-composition.ontology", "paths": [
      { "path": "camera.framing.shotScale", "valueKind": "enum", "cardinality": "one", "allowedValues": ["extreme_close_up", "close_up", "head_and_shoulders", "bust_shot", "medium_close_up", "medium_shot", "knee_shot", "full_shot", "long_shot", "extreme_long_shot"], "defaultImportance": "preferred" },
      { "path": "camera.framing.crop.keepHead", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.framing.crop.keepHands", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.framing.crop.keepBothFeet", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.framing.crop.keepProduct", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.framing.crop.keepSignatureProp", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" },
      { "path": "camera.view.elevation", "valueKind": "enum", "cardinality": "one", "allowedValues": ["eye_level", "low_angle", "high_angle", "birds_eye"], "defaultImportance": "preferred" }, { "path": "camera.view.relationship", "valueKind": "enum", "cardinality": "one", "allowedValues": ["front", "three_quarter", "profile", "rear", "over_the_shoulder"], "defaultImportance": "preferred" }, { "path": "camera.roll.mode", "valueKind": "enum", "cardinality": "one", "allowedValues": ["level", "dutch_left", "dutch_right"], "defaultImportance": "preferred" }, { "path": "camera.lens.focalLengthClass", "valueKind": "enum", "cardinality": "one", "allowedValues": ["ultra_wide", "wide", "normal", "telephoto", "super_telephoto"], "defaultImportance": "preferred" }, { "path": "camera.lens.perspective", "valueKind": "enum", "cardinality": "one", "allowedValues": ["expanded", "natural", "compressed"], "defaultImportance": "preferred" },
      { "path": "camera.composition.patterns.centeredSymmetry", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.patterns.ruleOfThirds", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.patterns.leadingLines", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.patterns.diagonal", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.patterns.sCurve", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.patterns.triangle", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" },
      { "path": "camera.composition.placement", "valueKind": "enum", "cardinality": "one", "allowedValues": ["center", "left_third", "right_third", "upper_third", "lower_third"], "defaultImportance": "preferred" }, { "path": "camera.composition.negativeSpace", "valueKind": "enum", "cardinality": "one", "allowedValues": ["none", "left", "right", "above", "below", "surrounding"], "defaultImportance": "preferred" }, { "path": "camera.composition.leadingRoom.enabled", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.leadingRoom.direction", "valueKind": "enum", "cardinality": "one", "allowedValues": ["left", "right", "forward", "up", "down"], "defaultImportance": "preferred" },
      { "path": "camera.composition.foregroundTreatment", "valueKind": "enum", "cardinality": "one", "allowedValues": ["clear", "soft_obstruction", "strong_obstruction"], "defaultImportance": "preferred" }, { "path": "camera.composition.framingDevices.frameWithinFrame", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.framingDevices.environmentalPortrait", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.reflection.enabled", "valueKind": "boolean", "cardinality": "one", "defaultImportance": "preferred" }, { "path": "camera.composition.reflection.surface", "valueKind": "enum", "cardinality": "one", "allowedValues": ["mirror", "glass", "water", "screen", "polished_surface"], "defaultImportance": "preferred" }, { "path": "camera.composition.reflection.role", "valueKind": "enum", "cardinality": "one", "allowedValues": ["supporting", "co_primary", "primary"], "defaultImportance": "preferred" }, { "path": "camera.composition.environmentRelationship", "valueKind": "enum", "cardinality": "one", "allowedValues": ["isolated", "contextual", "environment_dominant"], "defaultImportance": "preferred" }, { "path": "lighting.subjectRendering", "valueKind": "enum", "cardinality": "one", "allowedValues": ["natural", "silhouette"], "defaultImportance": "preferred" }
    ] }],
    "promptSections": [{ "id": "visual-composition.prompt-policy", "sections": [
      { "id": "subject-and-product-fidelity", "group": "subject-and-product-fidelity", "order": 1, "pathPrefixes": ["person", "product", "wardrobe"], "templateKey": "composition.subject-and-product-fidelity" }, { "id": "pose-and-object-relations", "group": "pose-and-object-relations", "order": 2, "pathPrefixes": ["pose", "prop", "object"], "templateKey": "composition.pose-and-object-relations" }, { "id": "composition-shot-and-crop", "group": "composition-shot-and-crop", "order": 3, "pathPrefixes": ["camera.framing"], "templateKey": "composition.composition-shot-and-crop" }, { "id": "composition-view-and-roll", "group": "composition-view-and-roll", "order": 4, "pathPrefixes": ["camera.view", "camera.roll"], "templateKey": "composition.composition-view-and-roll" }, { "id": "composition-layout-and-space", "group": "composition-layout-and-space", "order": 5, "pathPrefixes": ["camera.composition.patterns", "camera.composition.placement", "camera.composition.negativeSpace", "camera.composition.leadingRoom"], "templateKey": "composition.composition-layout-and-space" }, { "id": "composition-depth-framing-and-reflection", "group": "composition-depth-framing-and-reflection", "order": 6, "pathPrefixes": ["camera.composition.foregroundTreatment", "camera.composition.framingDevices", "camera.composition.reflection"], "templateKey": "composition.composition-depth-framing-and-reflection" }, { "id": "composition-lens-and-environment", "group": "composition-lens-and-environment", "order": 7, "pathPrefixes": ["camera.lens", "camera.composition.environmentRelationship"], "templateKey": "composition.composition-lens-and-environment" }, { "id": "forbidden-and-output", "group": "forbidden-and-output", "order": 8, "pathPrefixes": ["output"], "templateKey": "composition.forbidden-and-output" }
    ] }],
    "rulePacks": [
      { "id": "product-shot.rules", "namespace": "voce.fixture.product-shot", "rules": [
        { "id": "visual-composition-leading-room-direction", "kind": "dependency", "operands": [{ "id": "leading-room", "conditions": [{ "path": "camera.composition.leadingRoom.enabled", "operator": "equals", "value": true }] }, { "id": "direction", "conditions": [{ "path": "camera.composition.leadingRoom.direction", "operator": "present" }] }], "resolution": { "strategy": "degrade_operand", "operandId": "leading-room", "reasonCode": "LEADING_ROOM_DIRECTION_REQUIRED" }, "importance": "preferred", "dependencyKind": "requires", "explanation": "Leading room requires an explicit direction." },
        { "id": "visual-composition-reflection-surface", "kind": "dependency", "operands": [{ "id": "reflection", "conditions": [{ "path": "camera.composition.reflection.enabled", "operator": "equals", "value": true }] }, { "id": "surface", "conditions": [{ "path": "camera.composition.reflection.surface", "operator": "present" }] }], "resolution": { "strategy": "degrade_operand", "operandId": "reflection", "reasonCode": "REFLECTION_SURFACE_REQUIRED" }, "importance": "preferred", "dependencyKind": "requires", "explanation": "Reflection composition requires an explicit reflective surface." },
        { "id": "zero-person-assumption", "kind": "incompatibility", "operands": [{ "id": "product", "conditions": [{ "path": "product.geometry", "operator": "present" }] }, { "id": "person", "conditions": [{ "path": "person.identity", "operator": "present" }] }], "resolution": { "strategy": "block", "reasonCode": "PRODUCT_ZERO_PERSON" }, "importance": "hard", "code": "PRODUCT_ZERO_PERSON", "explanation": "Product fixtures do not introduce person identity constraints." },
        { "id": "product-fidelity", "kind": "incompatibility", "operands": [{ "id": "material", "conditions": [{ "path": "product.material", "operator": "present" }] }, { "id": "background", "conditions": [{ "path": "environment.background", "operator": "present" }] }], "resolution": { "strategy": "block", "reasonCode": "PRODUCT_FIDELITY" }, "importance": "required", "code": "PRODUCT_FIDELITY", "explanation": "Product material and background are compiled as separate declarative requirements." }
      ] }
    ],
    "interpretationScopes": [
      { "id": "product-shot.scope.geometry", "ontologyPath": "product.geometry", "assetId": "ref-01" },
      { "id": "product-shot.scope.material", "ontologyPath": "product.material", "assetId": "ref-01" },
      { "id": "product-shot.scope.background", "ontologyPath": "environment.background", "assetId": "ref-01" },
      { "id": "product-shot.scope.camera", "ontologyPath": "camera", "assetId": "ref-01" },
      { "id": "product-shot.scope.lighting", "ontologyPath": "lighting", "assetId": "ref-01" }
    ]
  },
  "fixtures": [
    { "id": "product-shot.offline", "cases": [
      { "id": "case-product-shot-001", "profileId": "mock-image", "expectedStatus": "completed", "semanticReview": false, "humanPending": false,
        "scopePaths": ["product.geometry", "product.material", "environment.background", "camera.framing"],
        "coreProbes": [
          { "id": "product-zero-person", "intents": [
            { "id": "product-geometry", "operation": "create", "targetPath": "product.geometry", "requestedValue": "box", "importance": "required" },
            { "id": "product-material", "operation": "preserve", "targetPath": "product.material", "requestedValue": "metal", "importance": "required" }
          ] }
        ],
        "expectedAssertions": [
          { "id": "product-no-person-observations", "phase": "compile", "target": "reference.personObservationCount", "operator": "equals", "expected": 0 },
          { "id": "product-no-person-intents", "phase": "compile", "target": "coreProbes.product-zero-person.personIntentCount", "operator": "equals", "expected": 0 },
          { "id": "product-core-success", "phase": "compile", "target": "coreProbes.product-zero-person.status", "operator": "equals", "expected": "ok" },
          { "id": "product-constraint-hash", "phase": "compile", "target": "coreProbes.product-zero-person.constraintHash", "operator": "sha256" },
          { "id": "product-execution", "phase": "run", "target": "run.executionStatus", "operator": "equals", "expected": "completed" },
          { "id": "product-trace", "phase": "run", "target": "run.traceModelHash", "operator": "sha256" }
        ] }
    ] }
  ]
}
