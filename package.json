{
  "name": "visual-ontology-constraint-engine",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Visual ontology, constraint compilation, prompt optimization, and evaluation for reference-guided image generation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "repository-validate": "node scripts/validate-repository.mjs",
    "validate": "node scripts/validate-repository.mjs && tsc -b && node scripts/run-tests.mjs",
    "typecheck": "tsc -b",
    "test": "tsc -b && node scripts/run-tests.mjs",
    "build": "tsc -b",
    "cli": "node packages/cli/dist/cli.js",
    "release-candidate": "node scripts/release-candidate.mjs",
    "clean-room": "node scripts/clean-room.mjs"
  },
  "workspaces": ["packages/*"],
  "devDependencies": { "typescript": "^5.6.3", "@types/node": "^22.0.0" },
  "license": "Apache-2.0"
}
