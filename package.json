{
  "name": "visual-ontology-constraint-engine",
  "version": "0.1.0-rc.4",
  "private": true,
  "description": "Visual ontology, constraint compilation, prompt optimization, and evaluation for reference-guided image generation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "repository-validate": "node scripts/validate-repository.mjs",
    "validate": "node scripts/validate-repository.mjs && tsc -b && node scripts/run-tests.mjs",
    "typecheck": "tsc -b",
    "test": "tsc -b && node scripts/run-tests.mjs",
    "build": "tsc -b",
    "cli": "node packages/cli/dist/cli.js",
    "compatibility": "node scripts/compatibility.mjs",
    "consumer": "node scripts/consumer.mjs",
    "reproducibility": "node scripts/reproducibility.mjs",
    "release-candidate": "node scripts/release-candidate.mjs",
    "clean-room": "node scripts/clean-room.mjs",
    "security": "node scripts/security-gate.mjs",
    "verify-checksums": "node scripts/verify-checksums.mjs",
    "m9:preflight": "node scripts/m9-seedream-smoke.mjs --preflight-only",
    "m9:prepare": "node scripts/m9-seedream-smoke.mjs --prepare-assets-only",
    "m9:smoke": "node scripts/m9-seedream-smoke.mjs",
    "rc4:composition:preflight": "node scripts/m9-seedream-smoke.mjs --composition-acceptance --preflight-only",
    "rc4:composition:prepare": "node scripts/m9-seedream-smoke.mjs --composition-acceptance --prepare-assets-only",
    "rc4:composition:acceptance": "node scripts/m9-seedream-smoke.mjs --composition-acceptance"
  },
  "workspaces": ["packages/*"],
  "devDependencies": { "typescript": "^5.6.3", "@types/node": "^22.0.0" },
  "license": "Apache-2.0"
}
