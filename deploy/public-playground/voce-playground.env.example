# Public, single-process, compile-only baseline. Copy to
# /etc/voce-playground/voce-playground.env and keep it readable only by root.
PLAYGROUND_PUBLIC_MODE=1
PLAYGROUND_HOST=127.0.0.1
PLAYGROUND_PORT=4173
PLAYGROUND_EXTERNAL_SCHEME=https
PLAYGROUND_BEHIND_REVERSE_PROXY=1

# Quotas are in process memory. Do not run more than one process or instance.
# With every Provider transport disabled below, the effective Provider hard cap
# is zero calls, so this acknowledgement is safe for the compile-only baseline.
PLAYGROUND_SINGLE_INSTANCE=1
PLAYGROUND_PROVIDER_HARD_LIMITS_CONFIRMED=1
PLAYGROUND_SESSION_CALLS_PER_DAY=4
PLAYGROUND_CLIENT_CALLS_PER_DAY=12
PLAYGROUND_GLOBAL_CALLS_PER_DAY=50
PLAYGROUND_MAX_CONCURRENT_GENERATIONS=1
PLAYGROUND_SEEDREAM_CALLS_PER_MINUTE=5
PLAYGROUND_GROK_CALLS_PER_MINUTE=5
PLAYGROUND_CLOUDFLARE_CALLS_PER_MINUTE=10

# Nginx must enforce the same or a smaller raw request-body ceiling.
PLAYGROUND_REQUEST_BODY_LIMIT_BYTES=20100000

# Nginx is the only network peer. Never broaden this to a public CIDR.
PLAYGROUND_TRUST_PROXY=1
PLAYGROUND_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Compile/Inspect remains available. Generation is intentionally unavailable.
PLAYGROUND_ENABLE_SEEDREAM_TRANSPORT=0
PLAYGROUND_ENABLE_GROK_TRANSPORT=0
PLAYGROUND_ENABLE_CLOUDFLARE_TRANSPORT=0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Public production must never expose development-only paths.
PLAYGROUND_ENABLE_MOCK_RENDER=0
PLAYGROUND_DEVELOPMENT_MODE=0
PLAYGROUND_VALIDATION_EXPORT=0
