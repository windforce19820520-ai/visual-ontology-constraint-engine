{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@voce-engine/contracts": ["../packages/contracts/dist/index.d.ts"],
      "@voce-engine/core": ["../packages/core/dist/index.d.ts"]
    }
  },
  "references": [
    { "path": "../packages/contracts" },
    { "path": "../packages/core" }
  ],
  "include": ["src"]
}
