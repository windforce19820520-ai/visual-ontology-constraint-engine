# Public Playground configuration names only. Keep secrets empty in source control.
# Local defaults remain 127.0.0.1:4173 with public mode disabled.
PLAYGROUND_PUBLIC_MODE=0
PLAYGROUND_HOST=127.0.0.1
PLAYGROUND_PORT=4173
PLAYGROUND_EXTERNAL_SCHEME=http

# Public mode requires HTTPS at the external proxy, explicit single-instance
# operation, Provider/platform hard spending limits, and every numeric gate.
PLAYGROUND_SINGLE_INSTANCE=0
PLAYGROUND_PROVIDER_HARD_LIMITS_CONFIRMED=0
PLAYGROUND_SESSION_CALLS_PER_DAY=8
PLAYGROUND_CLIENT_CALLS_PER_DAY=24
PLAYGROUND_GLOBAL_CALLS_PER_DAY=100
PLAYGROUND_MAX_CONCURRENT_GENERATIONS=2
PLAYGROUND_SEEDREAM_CALLS_PER_MINUTE=10
PLAYGROUND_GROK_CALLS_PER_MINUTE=10
PLAYGROUND_CLOUDFLARE_CALLS_PER_MINUTE=30

# The same-origin reverse proxy must reject bodies above this value too.
PLAYGROUND_REQUEST_BODY_LIMIT_BYTES=20100000

# Forwarded IP headers are ignored unless both settings are explicit. List only
# the immediate reverse proxy addresses/CIDRs controlled by the operator.
PLAYGROUND_TRUST_PROXY=0
PLAYGROUND_TRUSTED_PROXY_CIDRS=

# Cloudflare token is server-side only. Never expose it to browser JavaScript.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Explicitly enable the allow-listed Workers AI HTTP transport.
PLAYGROUND_ENABLE_CLOUDFLARE_TRANSPORT=0

# Enable the allow-listed Seedream BYOK transport. No Seedream key belongs here:
# the browser supplies one ephemeral key for one confirmed Generate request.
PLAYGROUND_ENABLE_SEEDREAM_TRANSPORT=0

# Enable the allow-listed xAI BYOK transport. No xAI key belongs in environment
# configuration; the browser supplies one ephemeral key for one Generate call.
PLAYGROUND_ENABLE_GROK_TRANSPORT=0

# Optional local switches.
PLAYGROUND_ENABLE_MOCK_RENDER=0
PLAYGROUND_DEVELOPMENT_MODE=0
PLAYGROUND_VALIDATION_EXPORT=0
