# Deployment configuration names only. Keep values empty in source control.
# The token is server-side only. Never expose it to browser JavaScript or commit it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Explicitly enable the allow-listed Workers AI HTTP transport.
PLAYGROUND_ENABLE_CLOUDFLARE_TRANSPORT=0

# Enable the allow-listed Seedream BYOK transport. No Seedream key belongs here:
# the browser supplies one ephemeral key for one confirmed Generate request.
PLAYGROUND_ENABLE_SEEDREAM_TRANSPORT=0

# Optional local switches.
PLAYGROUND_ENABLE_MOCK_RENDER=0
PLAYGROUND_DEVELOPMENT_MODE=0
